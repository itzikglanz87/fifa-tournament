rules_version = '2';

/*  The tournament archive: two collections, nothing else, and only for a
    signed-in caller. db.js signs in anonymously by itself, so nobody has to
    type anything — but a passer-by holding the project id still cannot read
    or write without going through Firebase auth.

    Anonymous auth is a gate, not an identity: anyone who loads the page can
    pass it. For six friends and a FIFA archive that is a fair trade. To lock
    it down properly, see "Locking it down" in the README — it is a one-line
    change here plus a one-line change in db.js.
*/
service cloud.firestore {
  match /databases/{database}/documents {

    match /tournaments/{id} {
      allow read, write: if request.auth != null;
    }

    match /meta/{id} {
      allow read, write: if request.auth != null && id in ['config', 'newsroom', 'poll'];
    }

    // predictions, reactions and poll votes: one document per player per
    // match (or per poll), its id spelled from its own fields so nobody can
    // write in someone else's slot by accident. Everyone reads them.
    // a prediction is taken only from a player sitting that match out, and
    // only inside its window — 3 minutes from the push (predWindows, written
    // by the push server)
    function predWin(t, k) {
      return get(/databases/$(database)/documents/predWindows/$(string(t) + '_' + string(k))).data;
    }
    match /predictions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'k', 'who', 'h', 'a', 'at'])
        && request.resource.data.who is int && request.resource.data.who >= 0 && request.resource.data.who <= 5
        && request.resource.data.h is int && request.resource.data.h >= 0 && request.resource.data.h <= 30
        && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a <= 30
        && id == string(request.resource.data.t) + '_' + string(request.resource.data.k) + '_' + string(request.resource.data.who)
        && exists(/databases/$(database)/documents/predWindows/$(string(request.resource.data.t) + '_' + string(request.resource.data.k)))
        && request.time < predWin(request.resource.data.t, request.resource.data.k).close
        && request.resource.data.who in predWin(request.resource.data.t, request.resource.data.k).sit;
      allow delete: if false;
    }
    // a match being played right now: the score as it stands, written by
    // whoever is watching (or by the scoreboard reader on the computer) and
    // read live by everyone. Deleted when the match ends.
    match /live/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'k', 'h', 'a', 'startAt', 'at', 'by', 'src'])
        && request.resource.data.h is int && request.resource.data.h >= 0 && request.resource.data.h <= 30
        && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a <= 30
        && id == string(request.resource.data.t) + '_' + string(request.resource.data.k);
      allow delete: if request.auth != null;
    }

    match /predWindows/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /reactions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'k', 'who', 'e', 'at'])
        && request.resource.data.who is int && request.resource.data.who >= 0 && request.resource.data.who <= 5
        && request.resource.data.e is string && request.resource.data.e.size() <= 8
        && id == string(request.resource.data.t) + '_' + string(request.resource.data.k) + '_' + string(request.resource.data.who);
      allow delete: if false;
    }
    match /pollVotes/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['poll', 'who', 'days', 'at'])
        && request.resource.data.who is int && request.resource.data.who >= 0 && request.resource.data.who <= 5
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && id == request.resource.data.poll + '_' + string(request.resource.data.who);
      allow delete: if false;
    }

    // a phone that enables notifications registers its own token; nobody
    // can read the list — only the push server (admin SDK) does
    match /pushTokens/{token} {
      allow create, update: if request.auth != null
        && request.resource.data.token == token
        && request.resource.data.keys().hasOnly(['token', 'at', 'ua']);
      allow delete: if request.auth != null;
      allow read: if false;
    }

    // the activity log: a phone records that the app was opened. It can add
    // a line, never read, change or delete one — the admin reads the log
    // through the push server with the admin key
    match /visits/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['who', 'at', 'dev', 'app'])
        && (request.resource.data.who == null || (request.resource.data.who is int
            && request.resource.data.who >= 0 && request.resource.data.who <= 5))
        && request.resource.data.at is string && request.resource.data.at.size() < 40
        && request.resource.data.dev is string && request.resource.data.dev.size() < 40
        && request.resource.data.app in ['apk', 'app', 'web'];
      allow read, update, delete: if false;
    }

    // newsroom cards the admin sent as a push, frozen as sent: the push
    // server writes them, the app only reads the one a tap opens
    match /stories/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // pushLog is the server's own bookkeeping: no client access at all

    // everything else stays shut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
